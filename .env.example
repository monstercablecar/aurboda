# Database
export PGUSER=
export PGDATABASE=
export PGHOST=
export PGPASSWORD=

# External services
# OURA_CLIENT/OURA_SECRET are deprecated — configure in Admin Settings UI.
# If set here and the DB is empty, they are migrated once at startup.
export RESCUETIME_KEY=

# Backend server
export PORT=3000
export WEB_HOST=http://localhost:5173
export API_BASE_URL=http://localhost:3000

# Frontend (Vite)
VITE_API_URL=http://localhost:3000

# Shared Resources library: persistent server-owned directory, never a static web root.
# Local development: use a writable absolute path; containers mount /data/resources.
export RESOURCES_STORAGE_DIR=/data/resources
export RESOURCES_MAX_UPLOAD_BYTES=268435456
# Also adjust nginx.conf's resource-specific body limit when changing this limit.

# Build-time opt-in only for the Foghouse-operated instance. Rebuild the web app after changing.
# Leave false for other self-hosters; this does not configure hosting or retention.
VITE_FOGHOUSE_PRIVACY_ENABLED=false
